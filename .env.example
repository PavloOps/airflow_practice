AIRFLOW_VERSION=3.2.1
AIRFLOW_PROJECT_DIR=/opt/analytics-airflow
# Use the host user id that owns AIRFLOW_PROJECT_DIR. Check with: id -u
AIRFLOW_UID=1000

POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=airflow
POSTGRES_PORT=5432

SUPERSET_DB_USER=superset_reader
SUPERSET_DB_PASSWORD=change_me_superset_reader_password

AIRFLOW_PORT=8080
ADMINER_PORT=8081

BACKUP_RETENTION_DAYS=14

AIRFLOW__CORE__PARALLELISM=8
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=4
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=1

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin_password
AIRFLOW_ADMIN_FIRSTNAME=Airflow
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=airflow-admin@example.com

AIRFLOW_DATA_ENGINEER_USERNAME=data_engineer
AIRFLOW_DATA_ENGINEER_PASSWORD=change_me_data_engineer_password
AIRFLOW_DATA_ENGINEER_FIRSTNAME=Data
AIRFLOW_DATA_ENGINEER_LASTNAME=Engineer
AIRFLOW_DATA_ENGINEER_EMAIL=data-engineer@example.com

AIRFLOW_ANALYTICS_HEAD_USERNAME=analytics_head
AIRFLOW_ANALYTICS_HEAD_PASSWORD=change_me_analytics_head_password
AIRFLOW_ANALYTICS_HEAD_FIRSTNAME=Analytics
AIRFLOW_ANALYTICS_HEAD_LASTNAME=Head
AIRFLOW_ANALYTICS_HEAD_EMAIL=analytics-head@example.com

AIRFLOW_BUSINESS_ANALYTIC_USERNAME=business_analytic
AIRFLOW_BUSINESS_ANALYTIC_PASSWORD=change_me_business_analytic_password
AIRFLOW_BUSINESS_ANALYTIC_FIRSTNAME=Business
AIRFLOW_BUSINESS_ANALYTIC_LASTNAME=Analytic
AIRFLOW_BUSINESS_ANALYTIC_EMAIL=business-analytic@example.com

# Generate with: ./scripts/generate_fernet_key.sh
AIRFLOW__CORE__FERNET_KEY=change_me_fernet_key

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW__API_AUTH__JWT_SECRET=change_me_jwt_secret
